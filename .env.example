# Environment
ENVIRONMENT=dev                          # dev | uat | stg | prod

# OpenAI (embeddings + Realtime API only)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM provider: "groq" (default) or "bedrock" (Amazon Bedrock / Claude)
LLM_PROVIDER=groq

# Groq (LLM inference — router, policy, payment, loan, FAQ, beneficiary, name extraction)
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b               # FAQ, policy, loan, payment, beneficiary nodes
ROUTER_MODEL=qwen/qwen3.8-27b             # router only — fast single-word classifier

# Amazon Bedrock (used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
ROUTER_BEDROCK_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_ACCESS_KEY_ID=...                    # local Bedrock testing only (ECS uses task role)
# AWS_SECRET_ACCESS_KEY=...                # local Bedrock testing only (ECS uses task role)

# Feature flags — tune at runtime via env vars, no deploy needed
ENABLE_RAG=true                            # false = skip pgvector, FAQ uses canned response
FAQ_FALLBACK_TO_ESCALATE=false            # true = no-RAG-match routes to agent
MAX_AUTH_ATTEMPTS=3                        # max PII retries before escalation

# Deepgram (STT)
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-2                    # nova-2 | nova-3 | whisper-medium
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENCODING=mulaw                  # must match Twilio Media Streams format
DEEPGRAM_SAMPLE_RATE=8000               # telephony standard — do not change
DEEPGRAM_CHANNELS=1                     # mono — do not change
DEEPGRAM_ENDPOINTING=300               # ms of silence to finalize utterance
DEEPGRAM_UTTERANCE_END_MS=1000         # safety-net finalize timeout
DEEPGRAM_SMART_FORMAT=True             # auto-format dates/numbers/currencies
DEEPGRAM_INTERIM_RESULTS=True          # enables barge-in VAD
DEEPGRAM_PUNCTUATE=True
DEEPGRAM_NO_DELAY=True                 # disable internal buffering for low latency

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel
ELEVENLABS_MODEL=eleven_turbo_v2            # eleven_turbo_v2 | eleven_monolingual_v1 | eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=3    # 0-4; 3 = IVR optimized

# OpenAI TTS (WebSocket stream path)
OPENAI_TTS_MODEL=tts-1                 # tts-1 (low latency) | tts-1-hd (higher quality)
OPENAI_TTS_VOICE=nova                  # alloy | echo | fable | onyx | nova | shimmer

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_AGENT_PHONE_NUMBER=+1...          # live agent transfer number
TWILIO_API_KEY=SK...                     # Account → API Keys → Create Standard key
TWILIO_API_SECRET=...                    # shown once at creation time
TWILIO_TWIML_APP_SID=AP...              # Voice → TwiML Apps → Create → Voice URL = /webhook/voice

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL + pgvector (RAG)
DATABASE_URL=postgresql://user:pass@localhost:5432/cno_ivr

# CNO Backend APIs
CNO_API_BASE_URL=https://api.cno.example.com
CNO_API_KEY=...
CNO_JWT_SECRET=...                       # for payment integration flow

# Dashboard / browser-client auth (HTTP Basic)
# Leave DASHBOARD_PASSWORD empty to disable auth (dev only).
# In prod: set a strong random password.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Twilio webhook signature validation (set to true in prod)
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_BASE_URL=                         # e.g. https://abc.ngrok.io

# WebSocket /stream shared secret (leave empty to skip — dev only)
# Append ?token=<WS_AUTH_TOKEN> to your <Stream url> in TwiML.
WS_AUTH_TOKEN=

# CORS — comma-separated allowed origins; "*" for dev, e.g. "https://app.example.com" in prod
ALLOWED_ORIGINS=*

# App
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
